# ===== 大模型事后审计（默认 DeepSeek，OpenAI 兼容，可切换供应商）=====
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
# 兼容其他供应商
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== 数据库（日志 + 知识库）=====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/adr

# ===== Redis（内核事件异步队列）=====
REDIS_ADDR=localhost:6379
